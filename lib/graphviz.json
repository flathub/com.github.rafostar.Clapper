        "--without-gtk",
        "--without-gtkgl",
        "--without-gtkglext",
        "--without-gdk",
        "--without-gdk-pixbuf",
        "--without-qt",
        "--disable-static",
        "--disable-sharp",
        "--disable-go",
        "--disable-guile",
        "--disable-java",
        "--disable-javascript",
        "--disable-lua",
        "--disable-perl",
        "--disable-php",
        "--disable-python",
        "--disable-r",
        "--disable-ruby",
